<Window x:Class="SnapRAIDGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapRAID GUI"
        Width="1100" Height="750"
        MinWidth="900" MinHeight="600"
        Background="#f8fafc"
        Foreground="#1e293b"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#1e293b" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SnapRAID GUI" Foreground="#e2e8f0" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding OperationStatus}" Foreground="#94a3b8" FontSize="13" Margin="0,0,16,0"/>
                    <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Width="80" Height="28" FontSize="12" Visibility="{Binding IsRunningOperation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="Settings" Style="{StaticResource SlateButton}" Command="{Binding OpenSettingsCommand}" Width="90" Height="28" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" SelectionChanged="TabSelectionChanged" Background="#f8fafc">

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16" MinHeight="400">
                    <StackPanel>
                        <TextBlock Text="No data available. Click 'Status' to refresh." Foreground="#64748b" FontSize="14" HorizontalAlignment="Center" Margin="0,200,0,0" Visibility="{Binding StatusData, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>

                        <!-- Health Overview Cards Row -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Parity Fragmentation Card -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Parity Fragmentation" Foreground="#64748b" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding StatusData.ParityFragmentationPercent, StringFormat={}{0}%}" FontSize="36" FontWeight="Bold" Foreground="#1e293b" HorizontalAlignment="Center"/>
                                    <ProgressBar Value="{Binding StatusData.ParityFragmentationPercent}" Height="8" Margin="0,8,0,0" Background="#e2e8f0" Foreground="#3b82f6"/>
                                </StackPanel>
                            </Border>

                            <!-- Array Status Card -->
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Array Status" Foreground="#64748b" FontSize="12" Margin="0,0,0,8"/>
                                    <Border Background="{Binding StatusData.ArrayAgeStatus, Converter={StaticResource StatusColorConverter}}" CornerRadius="12" Padding="16,8" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding StatusData.ArrayAgeStatus}" Foreground="white" FontSize="18" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding StatusData.DaysSinceLastSync, StringFormat=Last sync: {0} day(s) ago}" FontSize="12" Foreground="#64748b" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Scrub Status Card -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Scrub Progress" Foreground="#64748b" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding StatusData.ScrubStatus}" FontSize="36" FontWeight="Bold" Foreground="#1e293b" HorizontalAlignment="Center"/>
                                    <ProgressBar Value="{Binding StatusData.ScrubbedBlocks}" Height="8" Margin="0,8,0,0" Background="#e2e8f0" Foreground="#22c55e"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Drive Fill Levels -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Drive Details" Foreground="#334155" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Drive Details — unified table from conf + live status -->
                                <ItemsControl ItemsSource="{Binding MergedDrives}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#f1f5f9" CornerRadius="6" Padding="12,10" Margin="0,3,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <!-- Type badge -->
                                                        <ColumnDefinition Width="70"/>
                                                        <!-- Name -->
                                                        <ColumnDefinition Width="130"/>
                                                        <!-- Path -->
                                                        <ColumnDefinition Width="*"/>
                                                        <!-- Usage: used / total -->
                                                        <ColumnDefinition Width="160"/>
                                                        <!-- Progress bar + % -->
                                                        <ColumnDefinition Width="160"/>
                                                        <!-- Free label -->
                                                        <ColumnDefinition Width="90"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Type badge -->
                                                    <Border Grid.Column="0" Background="{Binding Type, Converter={StaticResource StatusColorConverter}}" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Type}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Name -->
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#334155" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="8,0"/>

                                                    <!-- Path -->
                                                    <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="#64748b" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>

                                                    <!-- Used / Total -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                        <TextBlock Text="{Binding UsedGB}" Foreground="#334155" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text=" / " Foreground="#94a3b8" FontSize="12"/>
                                                        <TextBlock Text="{Binding TotalGB}" Foreground="#64748b" FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- Progress bar + fill % -->
                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="4,0">
                                                        <ProgressBar Value="{Binding FillPercent, Mode=OneWay}" Maximum="100" Height="10" Background="#e2e8f0"
                                                                     Foreground="{Binding FillPercent, Converter={StaticResource FillColorConverter}, Mode=OneWay}"
                                                                     Visibility="{Binding HasUsageData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding FillPercentText}" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Free % -->
                                                    <TextBlock Grid.Column="5" Text="{Binding FreePercentText}" Foreground="#22c55e" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                                                               Visibility="{Binding HasUsageData, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <TextBlock Text="No drive data available. Click 'Status' to refresh." Foreground="#94a3b8" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="{Binding StatusData, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=inverse}"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Actions -->
                        <TextBlock Text="Quick Actions" Foreground="#334155" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="Status" Style="{StaticResource SlateButton}" Command="{Binding StatusCommand}" Width="120" Height="40" Margin="4,0"/>
                            <Button Content="Diff" Style="{StaticResource SlateButton}" Command="{Binding DiffCommand}" Width="120" Height="40" Margin="4,0"/>
                            <Button Content="Sync" Style="{StaticResource SlateButton}" Command="{Binding SyncCommand}" Width="120" Height="40" Margin="4,0"/>
                            <Button Content="Scrub (New)" Style="{StaticResource SlateButton}" Command="{Binding ScrubNewCommand}" Width="130" Height="40" Margin="4,0"/>
                            <Button Content="Scrub (Full)" Style="{StaticResource SlateButton}" Command="{Binding ScrubFullCommand}" Width="130" Height="40" Margin="4,0"/>
                            <Button Content="SMART Check" Style="{StaticResource SlateButton}" Command="{Binding SmartCommand}" Width="120" Height="40" Margin="4,0"/>
                        </WrapPanel>

                        <!-- Diff Summary -->
                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding DiffData, Converter={StaticResource NullToVisibilityConverter}}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Diff Summary" Foreground="#334155" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DiffData.AddedFiles}" FontSize="28" FontWeight="Bold" Foreground="#22c55e" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Added" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DiffData.RemovedFiles}" FontSize="28" FontWeight="Bold" Foreground="#ef4444" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Removed" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DiffData.UpdatedFiles}" FontSize="28" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Updated" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DiffData.MovedFiles}" FontSize="28" FontWeight="Bold" Foreground="#3b82f6" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Moved" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Operations Tab -->
            <TabItem Header="Operations">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Diff Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Diff (Check for Changes)" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Compares current files against parity to detect changes. Shows added, removed, updated, and moved files." Foreground="#64748b" FontSize="12" Margin="0,0,0,12"/>
                                <Button Content="Run Diff" Style="{StaticResource SlateButton}" Command="{Binding DiffCommand}" Width="160" Height="44" FontSize="15" IsEnabled="{Binding !IsRunningOperation}"/>
                            </StackPanel>
                        </Border>

                        <!-- Sync Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Parity Update (Sync)" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Updates parity information. Runs diff first to check for large deletions." Foreground="#64748b" FontSize="12" Margin="0,0,0,12"/>
                                <Button Content="Run Sync" Style="{StaticResource SlateButton}" Command="{Binding SyncCommand}" Width="160" Height="44" FontSize="15" IsEnabled="{Binding !IsRunningOperation}"/>
                            </StackPanel>
                        </Border>

                        <!-- Scrub Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Scrub Operations" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="Checks data and parity for errors." Foreground="#64748b" FontSize="12" Margin="0,0,0,12"/>
                                <Button Content="Scrub (New)" Style="{StaticResource SlateButton}" Command="{Binding ScrubNewCommand}" Width="160" Height="38" HorizontalAlignment="Left" Margin="0,0,0,8" IsEnabled="{Binding !IsRunningOperation}"/>
                                <Button Content="Scrub (Full)" Style="{StaticResource SlateButton}" Command="{Binding ScrubFullCommand}" Width="160" Height="38" HorizontalAlignment="Left" IsEnabled="{Binding !IsRunningOperation}"/>
                            </StackPanel>
                        </Border>

                        <!-- Maintenance Section -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Maintenance" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="8">
                                        <TextBlock Text="Array Status" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Button Content="Refresh Status" Style="{StaticResource SlateButton}" Command="{Binding StatusCommand}" Width="160" Height="38" HorizontalAlignment="Left" IsEnabled="{Binding !IsRunningOperation}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8">
                                        <TextBlock Text="Disk Health (SMART)" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Button Content="Run SMART Check" Style="{StaticResource SlateButton}" Command="{Binding SmartCommand}" Width="160" Height="38" HorizontalAlignment="Left" IsEnabled="{Binding !IsRunningOperation}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8">
                                        <TextBlock Text="Fix / Undelete" Foreground="#334155" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Button Content="Run Fix" Style="{StaticResource DangerButton}" Command="{Binding FixCommand}" Width="160" Height="38" HorizontalAlignment="Left" IsEnabled="{Binding !IsRunningOperation}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Live Console -->
                        <TextBlock Text="Live Console" Foreground="#334155" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource CardStyle}">
                            <ScrollViewer x:Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" ScrollChanged="ConsoleTextBox_ScrollChanged">
                                <TextBox Text="{Binding ConsoleOutput}" FontFamily="Cascadia Code, Consolas" FontSize="13" Foreground="#1e293b" Background="#f8fafc" BorderThickness="0" Padding="12" TextWrapping="NoWrap" IsReadOnly="True" AcceptsReturn="True" PreviewKeyDown="ConsoleTextBox_PreviewKeyDown"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Configuration" Foreground="#334155" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <TextBlock Text="snapraid.exe Path" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.SnapRaidExePath}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SlateButton}" Command="{Binding BrowseSnapRaidExeCommand}" Height="32"/>
                        </Grid>

                        <TextBlock Text="snapraid.conf Path" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Settings.ConfFilePath}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SlateButton}" Command="{Binding BrowseConfFileCommand}" Height="32"/>
                        </Grid>

                        <TextBlock Text="Deletion Warning Threshold" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.DeletionWarningThreshold}" Margin="0,0,0,16" Width="200"/>
                        <TextBlock Text="Show warning if deletions exceed this number during sync" Foreground="#64748b" FontSize="11" Margin="0,0,0,24"/>

                        <CheckBox Content="Auto-refresh status" IsChecked="{Binding Settings.AutoRefreshStatus}" Margin="0,0,0,8"/>
                        <TextBlock Text="Refresh interval (seconds)" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.RefreshIntervalSeconds}" Width="200" Margin="0,0,0,24"/>

                        <TextBlock Text="Log Directory" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.LogDirectory}" Margin="0,0,0,24"/>

                        <Button Content="Save Settings" Style="{StaticResource SlateButton}" Command="{Binding SaveSettingsCommand}" Width="160" Height="40" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#e2e8f0" Padding="16,8">
            <Grid>
                <TextBlock Text="{Binding LogDirectoryPath}" Foreground="#64748b" FontSize="11"/>
                <TextBlock HorizontalAlignment="Right" Text="SnapRAID GUI v1.0" Foreground="#94a3b8" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Settings Dialog (Popup) -->
        <Popup x:Name="SettingsPopup" IsOpen="{Binding ShowSettingsDialog}" AllowsTransparency="True" Placement="Center" StaysOpen="False">
            <Border Background="#00000080" Width="1100" Height="750">
                <Border Background="white" CornerRadius="12" Padding="24" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Settings" Foreground="#334155" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="snapraid.exe Path" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.SnapRaidExePath}" Margin="0,0,0,12"/>
                        <Button Content="Browse..." Style="{StaticResource SlateButton}" Command="{Binding BrowseSnapRaidExeCommand}" Width="100" Height="30" Margin="0,0,0,16"/>

                        <TextBlock Text="snapraid.conf Path" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.ConfFilePath}" Margin="0,0,0,12"/>
                        <Button Content="Browse..." Style="{StaticResource SlateButton}" Command="{Binding BrowseConfFileCommand}" Width="100" Height="30" Margin="0,0,0,16"/>

                        <TextBlock Text="Deletion Warning Threshold" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.DeletionWarningThreshold}" Width="200" Margin="0,0,0,16"/>

                        <CheckBox Content="Auto-refresh status" IsChecked="{Binding Settings.AutoRefreshStatus}" Margin="0,0,0,8"/>
                        <TextBlock Text="Refresh interval (seconds)" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.RefreshIntervalSeconds}" Width="200" Margin="0,0,0,16"/>

                        <TextBlock Text="Log Directory" Foreground="#475569" FontSize="13" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Settings.LogDirectory}" Width="200" Margin="0,0,0,24"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Save" Style="{StaticResource SlateButton}" Command="{Binding SaveSettingsCommand}" Width="100" Height="36" Margin="0,0,8,0"/>
                            <Button Content="Cancel" Style="{StaticResource SlateButton}" Width="100" Height="36" Click="CancelButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Popup>
    </Grid>
</Window>
