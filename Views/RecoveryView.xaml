<UserControl x:Class="SnapRAIDGUI.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#f8fafc">

    <UserControl.Resources>
        <!-- Recursive tree template for FileTreeNode -->
        <HierarchicalDataTemplate x:Key="TreeNodeTemplate"
                                  ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status icon (file nodes) / folder icon -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusIcon}"
                           Foreground="{Binding StatusColor}"
                           FontSize="12" VerticalAlignment="Center"/>

                <!-- Name -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Name}"
                           Foreground="#1e293b"
                           FontSize="12"
                           FontWeight="{Binding IsDirectory, Converter={StaticResource BoolToFontWeightConverter}}"
                           VerticalAlignment="Center"
                           Margin="2,0"/>

                <!-- Folder summary -->
                <TextBlock Grid.Column="2"
                           Text="{Binding FolderStatusSummary}"
                           Foreground="{Binding FolderStatusColor}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"
                            Visibility="{Binding IsDirectory, Converter={StaticResource InvertibleBoolToVisibilityConverter}}"/>

                <!-- File size / date -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsDirectory, Converter={StaticResource InvertibleBoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <TextBlock Text="{Binding SizeDisplay}" Foreground="#64748b" FontSize="10" Margin="4,0"/>
                    <TextBlock Text="{Binding LastModifiedDisplay}" Foreground="#94a3b8" FontSize="10"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- main content -->
            <RowDefinition Height="120"/>   <!-- console -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ─────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1e293b" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Browse Tree"
                        Command="{Binding LoadTreeCommand}"
                        Style="{StaticResource SlateButton}"
                        Height="32" Padding="12,0" Margin="0,0,12,0"
                        ToolTip="Load all files into the tree browser (slow — loads full file list)"/>

                <!-- Search box -->
                <Border Grid.Column="1" Background="#334155" CornerRadius="6" Padding="8,0"
                        MaxWidth="400" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchPattern, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontSize="13"
                                 VerticalAlignment="Center" Padding="4,6"
                                 FontFamily="Cascadia Code, Consolas">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="🔍" Background="Transparent" BorderThickness="0"
                                Foreground="#94a3b8" FontSize="14" Padding="4,0"
                                Command="{Binding SearchCommand}" Cursor="Hand"/>
                    </Grid>
                </Border>

                <Button Grid.Column="2"
                        Content="✕ Cancel"
                        Command="{Binding CancelSearchCommand}"
                        Style="{StaticResource DangerButton}"
                        Height="32" Padding="10,0" Margin="4,0,0,0"
                        Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Button Grid.Column="3"
                        Content="Check Selected"
                        Command="{Binding CheckFileCommand}"
                        Style="{StaticResource SlateButton}"
                        Height="32" Padding="12,0" Margin="8,0,0,0"/>

                <Button Grid.Column="4"
                        Content="Fix Selected"
                        Command="{Binding FixFileCommand}"
                        Style="{StaticResource DangerButton}"
                        Height="32" Padding="12,0" Margin="8,0,0,0"/>

                <Button Grid.Column="5"
                        Content="Check All Results"
                        Command="{Binding CheckAllCommand}"
                        Style="{StaticResource SlateButton}"
                        Height="32" Padding="12,0" Margin="8,0,0,0"/>

                <!-- Status text -->
                <TextBlock Grid.Column="6"
                           Text="{Binding StatusText}"
                           Foreground="#94a3b8" FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ── Main split: Tree | Results ───────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Tree browser -->
            <Border Grid.Column="0" Background="White" BorderBrush="#e2e8f0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#f1f5f9" Padding="12,8" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                        <TextBlock Text="Array Browser" Foreground="#334155" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="4">
                        <TreeView ItemsSource="{Binding TreeRoots}"
                                  ItemTemplate="{StaticResource TreeNodeTemplate}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="12">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2,1"/>
                                    <EventSetter Event="Selected" Handler="TreeItem_Selected"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#e2e8f0" ResizeBehavior="PreviousAndNext"/>

            <!-- Right: Search results list -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column headers -->
                <Border Grid.Row="0" Background="#f1f5f9" Padding="12,8" BorderBrush="#e2e8f0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="" FontSize="11" Foreground="#64748b"/>
                        <TextBlock Grid.Column="1" Text="Path" FontSize="11" Foreground="#64748b" FontWeight="SemiBold" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="Directory" FontSize="11" Foreground="#64748b" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Size" FontSize="11" Foreground="#64748b" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="Modified" FontSize="11" Foreground="#64748b" FontWeight="SemiBold" Margin="8,0"/>
                    </Grid>
                </Border>

                <!-- Results list -->
                <ListView Grid.Row="1"
                          x:Name="ResultsListView"
                          ItemsSource="{Binding SearchResults}"
                          SelectedItem="{Binding SelectedFile}"
                          SelectionMode="Extended"
                          SelectionChanged="ResultsList_SelectionChanged"
                          Background="White"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#f1f5f9"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <!-- Status icon -->
                                <Border Grid.Column="0"
                                        Background="{Binding StatusColor}"
                                        CornerRadius="10" Width="20" Height="20"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusIcon}"
                                               Foreground="White" FontSize="11"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Filename -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileName}"
                                           Foreground="#1e293b" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="4,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativePath}"/>

                                <!-- Directory -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Directory}"
                                           Foreground="#64748b" FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativePath}"/>

                                <!-- Size -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SizeDisplay}"
                                           Foreground="#64748b" FontSize="11"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>

                                <!-- Modified -->
                                <TextBlock Grid.Column="4"
                                           Text="{Binding LastModified, StringFormat=yyyy-MM-dd}"
                                           Foreground="#94a3b8" FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#94a3b8" FontSize="14"
                           Visibility="{Binding HasFileList, Converter={StaticResource InvertibleBoolToVisibilityConverter}, ConverterParameter=inverse}">
                    Click <Bold>Load File List</Bold> to load all files from the SnapRAID array,
                    then search by wildcard (e.g. <Italic>*DSC_9509*</Italic>).
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ── Console ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          x:Name="RecoveryConsoleScroll">
                <TextBox Text="{Binding ConsoleOutput}"
                         FontFamily="Cascadia Code, Consolas" FontSize="11"
                         Foreground="#e2e8f0" Background="Transparent"
                         BorderThickness="0" Padding="12,8"
                         TextWrapping="NoWrap" IsReadOnly="True" AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
